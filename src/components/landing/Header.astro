---
import { Languages } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { GITHUB } from '@/config/site'
import { landing, routes, type Lang } from '@/i18n/landing'
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.astro'
import GithubIcon from './GithubIcon.astro'

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props
const t = landing[lang].nav
const path = Astro.url.pathname
const links = [
  { href: routes.guide[lang], label: t.guide },
  { href: routes.principles[lang], label: t.manifesto },
]
---
<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href={routes.home[lang]} aria-label="cocido" data-nav-logo><Logo /></a>
    <nav class="hidden items-center gap-1 sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            buttonVariants({ variant: 'ghost', size: 'sm' }),
            path === link.href ? 'text-foreground' : 'text-muted-foreground',
          ]}
        >{link.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a href={alternate} hreflang={lang === 'en' ? 'es' : 'en'} class={buttonVariants({ variant: 'ghost', size: 'sm' })} title={t.language}>
        <Languages />
        <span>{t.languageShort}</span>
      </a>
      <ThemeToggle label={t.theme} />
      {GITHUB ? (
        <a href={GITHUB} class={buttonVariants({ variant: 'ghost', size: 'icon' })} aria-label="GitHub"><GithubIcon /></a>
      ) : (
        <span class={buttonVariants({ variant: 'ghost', size: 'sm' })} aria-disabled="true" title={t.soon}>
          <GithubIcon />
        </span>
      )}
    </div>
  </div>
  <nav class="flex gap-1 border-t px-2 py-1 sm:hidden">
    {links.map((link) => (
      <a href={link.href} class={buttonVariants({ variant: 'ghost', size: 'sm' })}>{link.label}</a>
    ))}
  </nav>
</header>
