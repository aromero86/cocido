---
import { Copy } from 'lucide-react'
import { CREATE_COMMAND, GITHUB } from '@/config/site'

interface Props { copy: string; disabledLabel: string }
const { copy, disabledLabel } = Astro.props
// Until launch the package name is a stand-in: copying it could install somebody else's package.
const launched = GITHUB !== null
---
<div class="flex w-full max-w-md items-center gap-3 rounded-lg border bg-muted/60 py-2 pl-4 pr-2 font-mono text-sm shadow-xs">
  <span class="select-none text-muted-foreground">$</span>
  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-left" data-command>{CREATE_COMMAND}</code>
  {launched ? (
    <button type="button" data-copy class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground" aria-label={copy} title={copy}><Copy className="size-4" /></button>
  ) : (
    <span class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground opacity-40" aria-disabled="true" title={disabledLabel}><Copy className="size-4" /></span>
  )}
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const text = button.parentElement?.querySelector('[data-command]')?.textContent ?? ''
      try { await navigator.clipboard.writeText(text) } catch {}
    })
  }
</script>
