---
import { Check, CircleCheck, FileCode, GitPullRequest, MessageSquare } from 'lucide-react'
import { landing, type Lang } from '@/i18n/landing'
import { diffLines, prFiles } from './pr-diff'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = landing[lang].problem

const lines = diffLines()
const viewed = 3
const last = t.chain.length - 1
const short = (path: string) => path.split('/').slice(-2).join('/')

// The minimap draws the lines shown again and again, to the size of the whole pull request (3,184 + 412 lines).
const mapRepeat = Math.round(3596 / lines.length)
const mapRows = mapRepeat * lines.length
// What fits on screen: some 26 lines of the whole.
const viewShare = Math.max(1.2, (26 / mapRows) * 100)
// While the diff goes through the lines shown once, the window on the map goes through one block of them.
const blockShare = (lines.length / mapRows) * 100
---
<section class="screen relative overflow-hidden border-b">
  <div class="mx-auto flex max-w-6xl flex-col gap-14 px-4 py-24 sm:px-6 lg:gap-10 lg:py-12">
    <!-- The question it all comes to. -->
    <div class="accountability flex flex-col items-center gap-5 text-center">
      <p class="cut-label" data-paper="red">{t.accountability.eyebrow}</p>
      <h3 class="max-w-4xl text-balance text-4xl font-semibold leading-[1.05] tracking-tighter sm:text-6xl lg:text-5xl">{t.accountability.title}</h3>
      <p class="max-w-2xl text-lg text-muted-foreground">{t.accountability.text}</p>
    </div>

    <div class="grid min-w-0 grid-cols-1 gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] lg:items-center">
      <!-- How control is lost. -->
      <div class="flex flex-col gap-8">
        <h3 class="text-2xl font-semibold tracking-tight">{t.chainTitle}</h3>
        <ol class="relative flex flex-col gap-7 border-l border-dashed pl-7">
          {t.chain.map((item, index) => (
            <li class="chain-step relative flex flex-col gap-1" style={`--i:${index}`}>
              <span class:list={[
                'absolute -left-[calc(1.75rem+0.6875rem)] top-0.5 flex size-[1.375rem] items-center justify-center rounded-full border bg-background font-mono text-[10px]',
                index === last ? 'border-red-500/70 bg-red-500/10 font-semibold text-red-600 dark:border-red-400/70 dark:text-red-400' : 'text-muted-foreground',
              ]}>{index + 1}</span>
              <h4 class:list={['font-semibold', index === last && 'text-destructive dark:text-red-400']}>{item.title}</h4>
              <p class="text-sm text-muted-foreground">{item.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- The pull request: endless, and approved. -->
      <figure class="pr relative flex min-w-0 flex-col overflow-hidden rounded-xl border bg-card shadow-2xl">
        <header class="flex flex-col gap-2 border-b px-4 py-3">
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-primary px-2.5 py-0.5 text-xs font-medium text-primary-foreground"><GitPullRequest className="size-3.5" />Open</span>
            <span class="truncate font-semibold">{t.pr} <span class="font-normal text-muted-foreground">#212</span></span>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
            <span>{t.author}</span>
            <span>{t.commits}</span>
            <span class="font-mono"><span class="text-brand">+3,184</span> <span class="text-destructive dark:text-red-400">−412</span></span>
            <span class="ml-auto inline-flex items-center gap-2 font-mono">
              <span class="h-1.5 w-20 overflow-hidden rounded-full bg-muted"><span class="block h-full rounded-full bg-brand" style={`width:${(viewed / prFiles.length) * 100}%`}></span></span>
              {viewed} / {prFiles.length} {t.viewed}
            </span>
          </div>
        </header>

        <div class="relative grid h-[30rem] lg:h-[22rem] grid-rows-[minmax(0,1fr)] overflow-hidden grid-cols-[minmax(0,1fr)_2rem] md:grid-cols-[13rem_minmax(0,1fr)_2.5rem]" aria-hidden="true">
          <!-- The file tree: three viewed, the rest never opened. -->
          <ul class="hidden flex-col gap-0.5 overflow-hidden border-r bg-muted/30 p-2 font-mono text-[10.5px] md:flex">
            {prFiles.map((file, index) => (
              <li class:list={['flex shrink-0 items-center gap-1.5 truncate rounded px-1.5 leading-5', index < viewed ? 'text-foreground' : 'text-muted-foreground/70']}>
                {index < viewed ? <Check className="size-3 shrink-0 text-brand" /> : <FileCode className="size-3 shrink-0 opacity-60" />}
                <span class="truncate">{short(file)}</span>
              </li>
            ))}
          </ul>

          <!-- The diff scrolls by on its own, faster than anyone reads. -->
          <div class="relative min-w-0 overflow-hidden">
            <div class="pr-scroll font-mono text-[11px] leading-[1.7]">
              {[0, 1].map((copy) => (
                <div class="pr-copy" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {lines.map((line) => (
                    line.kind === 'file' ? (
                      <div class="mt-3 flex items-center gap-2 border-y bg-muted px-3 py-1.5 font-medium text-foreground">
                        <FileCode className="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="truncate">{line.text}</span>
                      </div>
                    ) : line.kind === 'hunk' ? (
                      <div class="whitespace-pre bg-sky-500/10 px-3 text-sky-700 dark:text-sky-300/80">{line.text}</div>
                    ) : (
                      <div class:list={[
                        'flex gap-2 whitespace-pre px-3',
                        line.kind === 'add' && 'bg-emerald-500/10',
                        line.kind === 'del' && 'bg-red-500/10',
                      ]}>
                        <span class="w-7 shrink-0 select-none text-right text-muted-foreground/50">{line.n ?? ''}</span>
                        <span class:list={['w-2.5 shrink-0 select-none', line.kind === 'add' ? 'text-emerald-600 dark:text-emerald-400' : line.kind === 'del' ? 'text-red-600 dark:text-red-400' : 'text-transparent']}>{line.kind === 'add' ? '+' : line.kind === 'del' ? '−' : ' '}</span>
                        <span class:list={[line.kind === 'ctx' ? 'text-muted-foreground' : 'text-foreground/85']}>{line.text}</span>
                      </div>
                    )
                  ))}
                </div>
              ))}
            </div>
            <div class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-card to-transparent"></div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-card to-transparent"></div>
          </div>

          <!-- The minimap: the whole pull request, and the sliver of it on screen. -->
          <div class="relative overflow-hidden border-l bg-muted/20 px-1 py-1">
            <svg class="size-full opacity-70 dark:opacity-100" viewBox={`0 0 40 ${mapRows}`} preserveAspectRatio="none">
              <defs>
                <g id="pr-map-block">
                  {lines.map((line, row) => (
                    <rect x="2" y={row} width={line.kind === 'file' ? 36 : Math.max(3, Math.min(36, line.text.length / 2.2))} height="0.8" class={`map-${line.kind}`} />
                  ))}
                </g>
              </defs>
              {Array.from({ length: mapRepeat }, (_, i) => <use href="#pr-map-block" y={i * lines.length} />)}
            </svg>
            <span class="pr-map-view absolute inset-x-0.5 top-1 rounded-sm border border-foreground/40 bg-foreground/10" style={`height:${viewShare}%;--block:${blockShare}%`}></span>
          </div>
        </div>

        <footer class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t bg-muted/40 px-4 py-3 text-xs">
          <span class="inline-flex items-center gap-1.5 font-medium text-brand"><CircleCheck className="size-4" />{t.approved}</span>
          <span class="inline-flex items-center gap-1.5 text-muted-foreground"><MessageSquare className="size-3.5" />0</span>
          <span class="ml-auto text-muted-foreground">{t.readTime} <span class="font-medium text-foreground">{t.readValue}</span></span>
          <span class="text-muted-foreground">{t.spent} <span class="font-medium text-destructive dark:text-red-400">{t.spentValue}</span></span>
        </footer>
      </figure>
    </div>
    <p class="-mt-12 text-right text-xs text-muted-foreground lg:-mt-8">{t.example}</p>

  </div>
</section>

<style is:global>
  /* Two copies of the diff, one under the other: moving up by one copy's height loops it seamlessly. */
  .pr .pr-scroll { animation: pr-scroll 60s linear infinite; }
  .pr:hover .pr-scroll, .pr:hover .pr-map-view { animation-play-state: paused; }
  .pr .pr-map-view { animation: pr-map 60s linear infinite; }
  @keyframes pr-map { from { top: 0.25rem; } to { top: var(--block); } }
  .pr .map-file { fill: color-mix(in srgb, var(--foreground) 35%, transparent); }
  .pr .map-hunk { fill: color-mix(in srgb, #458588 55%, transparent); }
  .pr .map-add { fill: color-mix(in srgb, #98971a 60%, transparent); }
  .pr .map-del { fill: color-mix(in srgb, #cc241d 60%, transparent); }
  .pr .map-ctx { fill: color-mix(in srgb, var(--foreground) 22%, transparent); }
  @keyframes pr-scroll { to { transform: translateY(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .pr .pr-scroll, .pr .pr-map-view { animation: none; }
  }
</style>
