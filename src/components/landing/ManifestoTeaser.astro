---
import { ArrowRight } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { landing, routes, type Lang } from '@/i18n/landing'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = landing[lang].manifesto
---
<section class="border-b bg-muted/40">
  <div class="mx-auto grid max-w-6xl items-end gap-10 px-4 py-24 sm:px-6 lg:grid-cols-[3fr_2fr]">
    <div class="flex flex-col gap-4">
      <p class="cut-label" data-paper="1">{t.eyebrow}</p>
      <blockquote class="border-l-2 border-brand pl-6 text-3xl font-medium leading-tight tracking-tight sm:text-4xl">{t.quote}</blockquote>
    </div>
    <div class="flex flex-col items-start gap-5">
      <p class="text-muted-foreground">{t.text}</p>
      <a href={routes.principles[lang]} class={buttonVariants({ variant: 'outline' })}>{t.cta} <ArrowRight /></a>
    </div>
  </div>
</section>
