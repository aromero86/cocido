---
import { ArrowRight } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { landing, routes, type Lang } from '@/i18n/landing'
import InstallCommand from './InstallCommand.astro'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = landing[lang]
---
<section>
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-28 text-center sm:px-6">
    <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">{t.end.title}</h2>
    <InstallCommand copy={t.hero.copy} disabledLabel={t.hero.copyDisabled} />
    <div class="flex flex-wrap justify-center gap-3">
      <a href={routes.guide[lang]} class={buttonVariants({ size: 'lg' })}>{t.end.start} <ArrowRight /></a>
      <a href={routes.principles[lang]} class={buttonVariants({ variant: 'outline', size: 'lg' })}>{t.end.manifesto}</a>
    </div>
  </div>
</section>
