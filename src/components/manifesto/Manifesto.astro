---
import { ArrowRight } from 'lucide-react'
import Base from '@/layouts/Base.astro'
import { buttonVariants } from '@/components/ui/button'
import { routes, type Lang } from '@/i18n/landing'
import { manifesto } from '@/i18n/manifesto'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = manifesto[lang]
const other: Lang = lang === 'en' ? 'es' : 'en'
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII']
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} alternate={routes.principles[other]}>
  <article class="mx-auto flex max-w-2xl flex-col gap-10 px-4 py-20 sm:px-6 sm:py-28">
    <header class="flex flex-col gap-6">
      <p class="cut-label" data-paper="1">{t.place}</p>
      <h1 class="text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">{t.title}</h1>
    </header>

    <div class="flex flex-col gap-5 text-lg leading-relaxed">
      {t.opening.map((paragraph, index) => (
        <p class:list={[index === 0 && 'font-medium']}>{paragraph}</p>
      ))}
    </div>

    <ol class="flex flex-col gap-7 border-y py-10">
      {t.theses.map((thesis, index) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4">
          <span class="pt-1 text-right font-mono text-sm text-brand">{roman[index]}.</span>
          <div class="flex flex-col gap-1">
            <p class="text-xl font-semibold leading-snug tracking-tight">{thesis.title}</p>
            <p class="text-muted-foreground">{thesis.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <footer class="flex flex-wrap items-center justify-between gap-6">
      <p class="text-2xl italic">— {t.signature}</p>
      <a href={routes.guide[lang]} class={buttonVariants()}>{t.start} <ArrowRight /></a>
    </footer>
  </article>
</Base>
